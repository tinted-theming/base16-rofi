! Base16 Serendipity Sunset
! Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #202231
! base01: #272938
! base02: #272938
! base03: #8d8f9e
! base04: #6b6d7c
! base05: #dee0ef
! base06: #dee0ef
! base07: #202231
! base08: #d1918f
! base09: #d1918f
! base0A: #a392dc
! base0B: #709bbd
! base0C: #d6b4b4
! base0D: #a0b6e8
! base0E: #a392dc
! base0F: #709bbd

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #272938, #272938, #202231

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #272938, #dee0ef, #272938, #272938, #202231
rofi.color-active:  #272938, #a0b6e8, #272938, #272938, #a0b6e8
rofi.color-urgent:  #272938, #d1918f, #272938, #272938, #d1918f

! Set the desired separator style
rofi.separator-style: solid
