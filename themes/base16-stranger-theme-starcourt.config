! Base16 Stranger Theme Starcourt
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1a1a2e
! base01: #2e2e42
! base02: #3d3d66
! base03: #8c77c3
! base04: #bababa
! base05: #eaeaea
! base06: #f6f6f6
! base07: #ffffff
! base08: #ff6b6b
! base09: #ffb347
! base0A: #ffd700
! base0B: #00fa9a
! base0C: #00ced1
! base0D: #ba55d3
! base0E: #ff1493
! base0F: #d78b1f

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #2e2e42, #2e2e42, #1a1a2e

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #2e2e42, #eaeaea, #2e2e42, #2e2e42, #ffffff
rofi.color-active:  #2e2e42, #ba55d3, #2e2e42, #2e2e42, #ba55d3
rofi.color-urgent:  #2e2e42, #ff6b6b, #2e2e42, #2e2e42, #ff6b6b

! Set the desired separator style
rofi.separator-style: solid
