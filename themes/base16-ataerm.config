! Base16 Aftertaerm
! Scheme author: Radek Polasek (https://github.com/radekp31), based on Taerminal by cozywigwam
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #26282a
! base01: #303234
! base02: #3c3e41
! base03: #6f6f6f
! base04: #a8a8a8
! base05: #f0f0f0
! base06: #f1f1f1
! base07: #ffffff
! base08: #ff8878
! base09: #ffb88a
! base0A: #fffcb7
! base0B: #b4fb73
! base0C: #a2e1f8
! base0D: #8bbce5
! base0E: #ffb2fe
! base0F: #d69a8a

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #303234, #303234, #26282a

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #303234, #f0f0f0, #303234, #303234, #ffffff
rofi.color-active:  #303234, #8bbce5, #303234, #303234, #8bbce5
rofi.color-urgent:  #303234, #ff8878, #303234, #303234, #ff8878

! Set the desired separator style
rofi.separator-style: solid
