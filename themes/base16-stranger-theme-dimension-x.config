! Base16 Stranger Theme Dimension X
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1e1a1a
! base01: #322e2e
! base02: #523535
! base03: #9a7c7c
! base04: #b8a5a5
! base05: #e8d5d5
! base06: #f4e1e1
! base07: #ffffff
! base08: #ff6b6b
! base09: #ff6b6b
! base0A: #d19a66
! base0B: #8fae7e
! base0C: #7fb5b0
! base0D: #c678dd
! base0E: #ff55aa
! base0F: #d74343

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #322e2e, #322e2e, #1e1a1a

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #322e2e, #e8d5d5, #322e2e, #322e2e, #ffffff
rofi.color-active:  #322e2e, #c678dd, #322e2e, #322e2e, #c678dd
rofi.color-urgent:  #322e2e, #ff6b6b, #322e2e, #322e2e, #ff6b6b

! Set the desired separator style
rofi.separator-style: solid
