! Base16 Github Light Colorblind
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #ffffff
! base01: #f6f8fa
! base02: #d1d9e0
! base03: #818b98
! base04: #59636e
! base05: #454c54
! base06: #25292e
! base07: #1f2328
! base08: #bc4c00
! base09: #953800
! base0A: #9a6700
! base0B: #0550ae
! base0C: #1b7c83
! base0D: #0969da
! base0E: #8250df
! base0F: #953800

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #f6f8fa, #f6f8fa, #ffffff

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #f6f8fa, #454c54, #f6f8fa, #f6f8fa, #1f2328
rofi.color-active:  #f6f8fa, #0969da, #f6f8fa, #f6f8fa, #0969da
rofi.color-urgent:  #f6f8fa, #bc4c00, #f6f8fa, #f6f8fa, #bc4c00

! Set the desired separator style
rofi.separator-style: solid
