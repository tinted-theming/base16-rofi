! Base16 Stranger Theme Upside Down
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #0d1117
! base01: #21252b
! base02: #2a3c4a
! base03: #7a8495
! base04: #c8c8c2
! base05: #f8f8f2
! base06: #fffffe
! base07: #ffffff
! base08: #e06c75
! base09: #d19a66
! base0A: #e5c07b
! base0B: #98c379
! base0C: #56b6c2
! base0D: #61afef
! base0E: #c678dd
! base0F: #a9723e

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #21252b, #21252b, #0d1117

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #21252b, #f8f8f2, #21252b, #21252b, #ffffff
rofi.color-active:  #21252b, #61afef, #21252b, #21252b, #61afef
rofi.color-urgent:  #21252b, #e06c75, #21252b, #21252b, #e06c75

! Set the desired separator style
rofi.separator-style: solid
