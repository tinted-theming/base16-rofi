! Base16 London
! Scheme author: xscriptor (https://github.com/xscriptor)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #ffffff
! base01: #f1f1f1
! base02: #e7e7e7
! base03: #333333
! base04: #7a7a7a
! base05: #333333
! base06: #242424
! base07: #aaaaaa
! base08: #333333
! base09: #444444
! base0A: #555555
! base0B: #444444
! base0C: #888888
! base0D: #666666
! base0E: #777777
! base0F: #303030

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #f1f1f1, #f1f1f1, #ffffff

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #f1f1f1, #333333, #f1f1f1, #f1f1f1, #aaaaaa
rofi.color-active:  #f1f1f1, #666666, #f1f1f1, #f1f1f1, #666666
rofi.color-urgent:  #f1f1f1, #333333, #f1f1f1, #f1f1f1, #333333

! Set the desired separator style
rofi.separator-style: solid
