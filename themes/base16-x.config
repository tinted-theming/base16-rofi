! Base16 X
! Scheme author: xscriptor (https://github.com/xscriptor)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #050505
! base01: #161616
! base02: #222123
! base03: #6b686e
! base04: #8a878e
! base05: #f7f1ff
! base06: #f9f4ff
! base07: #f7f1ff
! base08: #fc618d
! base09: #fca37a
! base0A: #fce566
! base0B: #7bd88f
! base0C: #5ad4e6
! base0D: #fd9353
! base0E: #948ae3
! base0F: #a66c51

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #161616, #161616, #050505

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #161616, #f7f1ff, #161616, #161616, #f7f1ff
rofi.color-active:  #161616, #fd9353, #161616, #161616, #fd9353
rofi.color-urgent:  #161616, #fc618d, #161616, #161616, #fc618d

! Set the desired separator style
rofi.separator-style: solid
