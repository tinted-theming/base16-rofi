! Base16 Corduroy Dark
! Scheme author: taysatte (https://github.com/taysatte)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #141016
! base01: #1b151e
! base02: #221a26
! base03: #7d7082
! base04: #9a8d9e
! base05: #ddd8df
! base06: #ddd8df
! base07: #5a5160
! base08: #e8758a
! base09: #f0a89b
! base0A: #f0bd9c
! base0B: #55a0a0
! base0C: #f0a89b
! base0D: #dc92a3
! base0E: #cf98c4
! base0F: #9a8d9e

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #1b151e, #1b151e, #141016

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #1b151e, #ddd8df, #1b151e, #1b151e, #5a5160
rofi.color-active:  #1b151e, #dc92a3, #1b151e, #1b151e, #dc92a3
rofi.color-urgent:  #1b151e, #e8758a, #1b151e, #1b151e, #e8758a

! Set the desired separator style
rofi.separator-style: solid
