! Base16 Stranger Theme The Lab
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1a1d26
! base01: #2e313a
! base02: #3c3f48
! base03: #73879c
! base04: #b0b5bc
! base05: #e0e5ec
! base06: #ecf1f8
! base07: #ffffff
! base08: #ff4136
! base09: #ff851b
! base0A: #ffdc00
! base0B: #2ecc40
! base0C: #39cccc
! base0D: #b10dc9
! base0E: #7fdbff
! base0F: #d75d00

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #2e313a, #2e313a, #1a1d26

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #2e313a, #e0e5ec, #2e313a, #2e313a, #ffffff
rofi.color-active:  #2e313a, #b10dc9, #2e313a, #2e313a, #b10dc9
rofi.color-urgent:  #2e313a, #ff4136, #2e313a, #2e313a, #ff4136

! Set the desired separator style
rofi.separator-style: solid
