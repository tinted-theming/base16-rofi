! Base16 Serendipity Morning
! Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #f6f7fb
! base01: #eaebee
! base02: #eaebee
! base03: #6d7296
! base04: #505575
! base05: #3f4363
! base06: #3f4363
! base07: #f6f7fb
! base08: #c25a4d
! base09: #c25a4d
! base0A: #785fd0
! base0B: #2f7aab
! base0C: #e58678
! base0D: #6288d8
! base0E: #785fd0
! base0F: #2f7aab

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #eaebee, #eaebee, #f6f7fb

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #eaebee, #3f4363, #eaebee, #eaebee, #f6f7fb
rofi.color-active:  #eaebee, #6288d8, #eaebee, #eaebee, #6288d8
rofi.color-urgent:  #eaebee, #c25a4d, #eaebee, #eaebee, #c25a4d

! Set the desired separator style
rofi.separator-style: solid
