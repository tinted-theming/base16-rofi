! Base16 nightfox
! Scheme author: EdenEast (https://github.com/EdenEast)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #192330
! base01: #212e3f
! base02: #29394f
! base03: #575860
! base04: #71839b
! base05: #cdcecf
! base06: #aeafb0
! base07: #e4e4e5
! base08: #c94f6d
! base09: #f4a261
! base0A: #dbc074
! base0B: #81b29a
! base0C: #63cdcf
! base0D: #719cd6
! base0E: #9d79d6
! base0F: #d67ad2

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #212e3f, #212e3f, #192330

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #212e3f, #cdcecf, #212e3f, #212e3f, #e4e4e5
rofi.color-active:  #212e3f, #719cd6, #212e3f, #212e3f, #719cd6
rofi.color-urgent:  #212e3f, #c94f6d, #212e3f, #212e3f, #c94f6d

! Set the desired separator style
rofi.separator-style: solid
