! Base16 Penumbra Dark Contrast Plus Plus
! Scheme author: Neal McKee (https://github.com/nealmckee/penumbra)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #101317
! base01: #1b1e23
! base02: #393c42
! base03: #575b62
! base04: #88898b
! base05: #a9a9a9
! base06: #c2c0bd
! base07: #eee8dd
! base08: #e17782
! base09: #d88f4c
! base0A: #b4a724
! base0B: #62b06c
! base0C: #00a8a4
! base0D: #009edb
! base0E: #8a90d4
! base0F: #be7fc4

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #1b1e23, #1b1e23, #101317

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #1b1e23, #a9a9a9, #1b1e23, #1b1e23, #eee8dd
rofi.color-active:  #1b1e23, #009edb, #1b1e23, #1b1e23, #009edb
rofi.color-urgent:  #1b1e23, #e17782, #1b1e23, #1b1e23, #e17782

! Set the desired separator style
rofi.separator-style: solid
