! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1a1a1a
! base01: #2a2a2a
! base02: #353535
! base03: #6272a4
! base04: #989898
! base05: #ffffff
! base06: #ffffff
! base07: #ffffff
! base08: #ff5555
! base09: #ff9c7c
! base0A: #ffe4a3
! base0B: #b8e6a0
! base0C: #8be9fd
! base0D: #bd93f9
! base0E: #ff9aa2
! base0F: #af6e5a

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #2a2a2a, #2a2a2a, #1a1a1a

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #2a2a2a, #ffffff, #2a2a2a, #2a2a2a, #ffffff
rofi.color-active:  #2a2a2a, #bd93f9, #2a2a2a, #2a2a2a, #bd93f9
rofi.color-urgent:  #2a2a2a, #ff5555, #2a2a2a, #2a2a2a, #ff5555

! Set the desired separator style
rofi.separator-style: solid
