! Base16 Apprentice
! Scheme author: Romain Lafourcade (https://github.com/romainl)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #262626
! base01: #303030
! base02: #3a3a3a
! base03: #444444
! base04: #6c6c6c
! base05: #bcbcbc
! base06: #dfdfdf
! base07: #ffffff
! base08: #af5f5f
! base09: #ff8700
! base0A: #87875f
! base0B: #5f875f
! base0C: #5f8787
! base0D: #5f87af
! base0E: #5f5f87
! base0F: #af5f5f

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #303030, #303030, #262626

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #303030, #bcbcbc, #303030, #303030, #ffffff
rofi.color-active:  #303030, #5f87af, #303030, #303030, #5f87af
rofi.color-urgent:  #303030, #af5f5f, #303030, #303030, #af5f5f

! Set the desired separator style
rofi.separator-style: solid
