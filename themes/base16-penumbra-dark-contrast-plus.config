! Base16 Penumbra Dark Contrast Plus
! Scheme author: Neal McKee (https://github.com/nealmckee/penumbra)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #1d2024
! base01: #292b30
! base02: #404246
! base03: #5b5d62
! base04: #7f7f81
! base05: #999999
! base06: #bab8b4
! base07: #efe8dd
! base08: #cd6b76
! base09: #c58145
! base0A: #a39720
! base0B: #58a061
! base0C: #009894
! base0D: #008fc6
! base0E: #7d82c0
! base0F: #ac72b2

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #292b30, #292b30, #1d2024

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #292b30, #999999, #292b30, #292b30, #efe8dd
rofi.color-active:  #292b30, #008fc6, #292b30, #292b30, #008fc6
rofi.color-urgent:  #292b30, #cd6b76, #292b30, #292b30, #cd6b76

! Set the desired separator style
rofi.separator-style: solid
