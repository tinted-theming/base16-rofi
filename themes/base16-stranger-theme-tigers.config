! Base16 Stranger Theme Tigers
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #181e18
! base01: #2c322c
! base02: #38463a
! base03: #758975
! base04: #c5c5c5
! base05: #f5f5f5
! base06: #ffffff
! base07: #ffffff
! base08: #cc6666
! base09: #de935f
! base0A: #f0c674
! base0B: #b5bd68
! base0C: #8abeb7
! base0D: #81a2be
! base0E: #b294bb
! base0F: #b66b37

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #2c322c, #2c322c, #181e18

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #2c322c, #f5f5f5, #2c322c, #2c322c, #ffffff
rofi.color-active:  #2c322c, #81a2be, #2c322c, #2c322c, #81a2be
rofi.color-urgent:  #2c322c, #cc6666, #2c322c, #2c322c, #cc6666

! Set the desired separator style
rofi.separator-style: solid
