! Base16 Pastelón de Amarillos
! Scheme author: Richard Martinez (https://sonofmartinus.com)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #fff4d6
! base01: #f2d083
! base02: #d69b45
! base03: #80616b
! base04: #684653
! base05: #432c3b
! base06: #2f1c2e
! base07: #1c0f20
! base08: #bd3548
! base09: #ad570f
! base0A: #946400
! base0B: #167451
! base0C: #007270
! base0D: #1e5da8
! base0E: #8d3f89
! base0F: #7c3528

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #f2d083, #f2d083, #fff4d6

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #f2d083, #432c3b, #f2d083, #f2d083, #1c0f20
rofi.color-active:  #f2d083, #1e5da8, #f2d083, #f2d083, #1e5da8
rofi.color-urgent:  #f2d083, #bd3548, #f2d083, #f2d083, #bd3548

! Set the desired separator style
rofi.separator-style: solid
