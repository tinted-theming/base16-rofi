! Base16 Sequoia Monochrome Light
! Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #edeef2
! base01: #e2e3e8
! base02: #e2e3e8
! base03: #9da2ad
! base04: #42434e
! base05: #282930
! base06: #282930
! base07: #0f1014
! base08: #525666
! base09: #525666
! base0A: #50535e
! base0B: #2e3038
! base0C: #454752
! base0D: #5f6370
! base0E: #50535e
! base0F: #2e3038

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #e2e3e8, #e2e3e8, #edeef2

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #e2e3e8, #282930, #e2e3e8, #e2e3e8, #0f1014
rofi.color-active:  #e2e3e8, #5f6370, #e2e3e8, #e2e3e8, #5f6370
rofi.color-urgent:  #e2e3e8, #525666, #e2e3e8, #e2e3e8, #525666

! Set the desired separator style
rofi.separator-style: solid
