! Base16 Stranger Theme Hawkins
! Scheme author: Stranger Theme (https://github.com/stranger-theme/stranger-theme)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #2c2218
! base01: #40362c
! base02: #4d4339
! base03: #9e8766
! base04: #b8ac98
! base05: #e8dcc8
! base06: #f4e8d4
! base07: #ffffff
! base08: #bf616a
! base09: #d08770
! base0A: #ebcb8b
! base0B: #a3be8c
! base0C: #88c0d0
! base0D: #b48ead
! base0E: #d4a574
! base0F: #a85f48

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #40362c, #40362c, #2c2218

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #40362c, #e8dcc8, #40362c, #40362c, #ffffff
rofi.color-active:  #40362c, #b48ead, #40362c, #40362c, #b48ead
rofi.color-urgent:  #40362c, #bf616a, #40362c, #40362c, #bf616a

! Set the desired separator style
rofi.separator-style: solid
