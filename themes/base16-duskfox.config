! Base16 duskfox
! Scheme author: EdenEast (https://github.com/EdenEast)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #232136
! base01: #2d2a45
! base02: #373354
! base03: #47407d
! base04: #6e6a86
! base05: #e0def4
! base06: #cdcbe0
! base07: #e2e0f7
! base08: #eb6f92
! base09: #ea9a97
! base0A: #f6c177
! base0B: #a3be8c
! base0C: #9ccfd8
! base0D: #569fba
! base0E: #c4a7e7
! base0F: #eb98c3

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #2d2a45, #2d2a45, #232136

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #2d2a45, #e0def4, #2d2a45, #2d2a45, #e2e0f7
rofi.color-active:  #2d2a45, #569fba, #2d2a45, #2d2a45, #569fba
rofi.color-urgent:  #2d2a45, #eb6f92, #2d2a45, #2d2a45, #eb6f92

! Set the desired separator style
rofi.separator-style: solid
