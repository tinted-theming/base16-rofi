! Base16 nordfox
! Scheme author: EdenEast (https://github.com/EdenEast)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #2e3440
! base01: #39404f
! base02: #444c5e
! base03: #465780
! base04: #7e8188
! base05: #cdcecf
! base06: #abb1bb
! base07: #e7ecf4
! base08: #bf616a
! base09: #c9826b
! base0A: #ebcb8b
! base0B: #a3be8c
! base0C: #88c0d0
! base0D: #81a1c1
! base0E: #b48ead
! base0F: #bf88bc

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #39404f, #39404f, #2e3440

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #39404f, #cdcecf, #39404f, #39404f, #e7ecf4
rofi.color-active:  #39404f, #81a1c1, #39404f, #39404f, #81a1c1
rofi.color-urgent:  #39404f, #bf616a, #39404f, #39404f, #bf616a

! Set the desired separator style
rofi.separator-style: solid
