! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #3f4451
! base01: #474c59
! base02: #4c515e
! base03: #6c727f
! base04: #7a808e
! base05: #abb2bf
! base06: #bcc1cc
! base07: #ffffff
! base08: #e05561
! base09: #d8725a
! base0A: #d18f52
! base0B: #8cc265
! base0C: #42b3c2
! base0D: #4aa5f0
! base0E: #c162de
! base0F: #a26257

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #474c59, #474c59, #3f4451

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #474c59, #abb2bf, #474c59, #474c59, #ffffff
rofi.color-active:  #474c59, #4aa5f0, #474c59, #474c59, #4aa5f0
rofi.color-urgent:  #474c59, #e05561, #474c59, #474c59, #e05561

! Set the desired separator style
rofi.separator-style: solid
