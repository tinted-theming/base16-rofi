! Base16 Serendipity Midnight
! Scheme author: Micheal Andreuzza (https://michaelandreuzza.com/)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #151726
! base01: #1c1e2d
! base02: #1c1e2d
! base03: #6b6d7c
! base04: #8d8f9e
! base05: #dee0ef
! base06: #dee0ef
! base07: #151726
! base08: #ee8679
! base09: #ee8679
! base0A: #a78bfa
! base0B: #5ba2d0
! base0C: #f8d2c9
! base0D: #94b8ff
! base0E: #a78bfa
! base0F: #5ba2d0

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #1c1e2d, #1c1e2d, #151726

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #1c1e2d, #dee0ef, #1c1e2d, #1c1e2d, #151726
rofi.color-active:  #1c1e2d, #94b8ff, #1c1e2d, #1c1e2d, #94b8ff
rofi.color-urgent:  #1c1e2d, #ee8679, #1c1e2d, #1c1e2d, #ee8679

! Set the desired separator style
rofi.separator-style: solid
