! Base16 Github Dark Colorblind
! Scheme author: Tinted Theming (https://github.com/tinted-theming)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #0d1117
! base01: #151b23
! base02: #2f3742
! base03: #656c76
! base04: #9198a1
! base05: #d1d7e0
! base06: #f0f6fc
! base07: #ffffff
! base08: #f0883e
! base09: #ffa657
! base0A: #d29922
! base0B: #58a6ff
! base0C: #39c5cf
! base0D: #58a6ff
! base0E: #be8fff
! base0F: #ffa657

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #151b23, #151b23, #0d1117

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #151b23, #d1d7e0, #151b23, #151b23, #ffffff
rofi.color-active:  #151b23, #58a6ff, #151b23, #151b23, #58a6ff
rofi.color-urgent:  #151b23, #f0883e, #151b23, #151b23, #f0883e

! Set the desired separator style
rofi.separator-style: solid
