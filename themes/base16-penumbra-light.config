! Base16 Penumbra Light
! Scheme author: Neal McKee (https://github.com/nealmckee/penumbra)
! Template author: Tinted Theming (https://github.com/tinted-theming)

! base00: #efe8dd
! base01: #dfd9d0
! base02: #d1ccc5
! base03: #b4b1ad
! base04: #a19f9d
! base05: #8b8b8b
! base06: #5e6063
! base07: #2c2e31
! base08: #bb626b
! base09: #b4763e
! base0A: #958a1c
! base0B: #509259
! base0C: #008a87
! base0D: #0082b5
! base0E: #7177b0
! base0F: #9d68a2

! Enable the extended coloring options
rofi.color-enabled: true

! Property Name     BG       Border   Separator
rofi.color-window:  #dfd9d0, #dfd9d0, #efe8dd

! Property Name     BG       FG       BG-alt   Head-BG  Head-FG
rofi.color-normal:  #dfd9d0, #8b8b8b, #dfd9d0, #dfd9d0, #2c2e31
rofi.color-active:  #dfd9d0, #0082b5, #dfd9d0, #dfd9d0, #0082b5
rofi.color-urgent:  #dfd9d0, #bb626b, #dfd9d0, #dfd9d0, #bb626b

! Set the desired separator style
rofi.separator-style: solid
